# General Bot Configuration

BOT_TOKEN=
ALLOWED_CHAT_ID=
ALLOW_PRIVATE_CHAT=true

# Limits
MAX_FILE_SIZE_MB=50
MAX_SONG_DURATION_MIN=15
CONCURRENT_DOWNLOAD_LIMIT=5

# Security and access
BLOCKED_USER_IDS=

# Spam 
ANTI_SPAM_INTERVAL=15 
ANTI_SPAM_CALLBACK_INTERVAL=1

# File Management
DB_FILE=songs_cache.db
INFO_EXPIRATION_HOURS=24
MUSIC_STORAGE_CHANNEL_ID=

# Post-save command
# Riga di comando eseguita dopo il salvataggio di una canzone (PowerShell su Windows, bash su Linux).
# Vuota = disattivato. Esempio: POST_SAVE_COMMAND=/usr/bin/rclone copy /home/raspuser/Music pcloud:Music --transfers 4 --log-level NOTICE
POST_SAVE_COMMAND=
# Secondi di attesa prima di lanciarlo, per raggruppare più salvataggi ravvicinati in una sola esecuzione.
POST_SAVE_COMMAND_DELAY=10

